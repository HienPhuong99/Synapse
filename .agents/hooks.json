{
  "synapse-presence": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../apps/server/dist/hook.js gemini 4321 SessionStart",
        "timeout": 2
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ../apps/server/dist/hook.js gemini 4321 PreInvocation",
        "timeout": 2
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../apps/server/dist/hook.js gemini 4321 PostToolUse",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../apps/server/dist/hook.js gemini 4321 Stop",
        "timeout": 2
      }
    ]
  }
}
